<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Title with item name -->
        <TextView
            android:id="@+id/tvSellTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <!-- Current stock info -->
        <TextView
            android:id="@+id/tvCurrentStock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#888888"
            android:layout_marginBottom="16dp"/>

        <!-- Error container -->
        <LinearLayout
            android:id="@+id/llSellDialogErrors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="12dp"/>

        <!-- Radio buttons for input mode -->
        <RadioGroup
            android:id="@+id/rgSellMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbQuantitySold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Quantity Sold"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/rbLeftover"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Leftover Quantity"/>

        </RadioGroup>

        <!-- Quantity input -->
        <TextView
            android:id="@+id/tvQuantityLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quantity Sold"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etSellQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter quantity"
            android:inputType="number"
            android:layout_marginBottom="8dp"/>

        <!-- Calculated result — shown when leftover mode is active -->
        <TextView
            android:id="@+id/tvCalculatedSold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#1976D2"
            android:visibility="gone"
            android:layout_marginBottom="16dp"/>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btnSellDialogCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:backgroundTint="#FFFFFF"
                android:textColor="#888888"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnSellDialogSubmit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirm Sale"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>