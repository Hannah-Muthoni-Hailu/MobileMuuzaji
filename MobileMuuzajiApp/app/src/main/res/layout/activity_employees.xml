<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:paddingTop="16dp"
    android:fitsSystemWindows="true"
    android:paddingBottom="24dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Employees"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnNewEmployee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ New Employee"
            android:textSize="12sp"/>

    </LinearLayout>

    <!-- Offline warning -->
    <TextView
        android:id="@+id/tvOfflineWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFF8E1"
        android:textColor="#F57F17"
        android:padding="12dp"
        android:textSize="13sp"
        android:text="You are offline. Employee management requires an internet connection."
        android:visibility="gone"/>

    <!-- Loading indicator -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"/>

    <!-- Error message -->
    <TextView
        android:id="@+id/tvError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFEBEE"
        android:textColor="#C62828"
        android:padding="12dp"
        android:textSize="14sp"
        android:visibility="gone"/>

    <!-- Success message -->
    <TextView
        android:id="@+id/tvSuccess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E8F5E9"
        android:textColor="#2E7D32"
        android:padding="12dp"
        android:textSize="14sp"
        android:visibility="gone"/>

    <!-- Empty state -->
    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="64dp"
        android:text="No employees yet"
        android:textSize="16sp"
        android:textColor="#888888"
        android:visibility="gone"/>

    <!-- Employee list -->
    <ListView
        android:id="@+id/lvEmployees"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="#EEEEEE"
        android:dividerHeight="1dp"/>

</LinearLayout>